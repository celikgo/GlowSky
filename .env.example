# Glowsky — environment configuration
# Copy to .env and fill in. NEVER commit .env (see .gitignore).

# --- Deployment environment (gates the secret-key guard) ---
# FAIL-SAFE DEFAULT: unset is treated as "production", so an unconfigured self-host is
# never silently insecure — the API REFUSES TO BOOT without a real GLOWSKY_SECRET_KEY
# (see below). That is why this line ships COMMENTED OUT: leaving it commented is the
# safe choice, and a copied .env can never silently weaken a real deployment.
#
# For local hacking, pick ONE:
#   a) uncomment the line below  -> the deterministic in-source dev key is used, or
#   b) set a real GLOWSKY_SECRET_KEY -> works in any environment.
# Recognised dev values: dev | development | local | test | testing | ci.
#GLOWSKY_ENVIRONMENT=dev

# --- Database (defaults to local SQLite; production -> Postgres) ---
GLOWSKY_DATABASE_URL=sqlite:///glowsky.db
# Production: point at Postgres (driver bundled via psycopg[binary]). Run `alembic upgrade
# head` against it first — the prod compose (docker-compose.prod.yml) does this automatically.
#   GLOWSKY_DATABASE_URL=postgresql+psycopg://glowsky:glowsky@localhost:5432/glowsky

# --- CORS ---
# Origins allowed to call the API from a browser/webview (comma-separated; "*" = any).
# The desktop app's webview and the Vite dev server are cross-origin to the API and must
# be listed, or the browser blocks every request (app shows "Backend offline").
GLOWSKY_CORS_ORIGINS=http://localhost:1420,http://127.0.0.1:1420,tauri://localhost,http://tauri.localhost

# --- Secrets at rest ---
# Fernet key used to encrypt stored BYO-LLM provider keys. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required in every non-dev environment: with GLOWSKY_ENVIRONMENT unset (=> production)
# and no key here, startup raises InsecureSecretKeyError and the API exits rather than
# fall back to the deterministic dev key, which is public-by-construction in this repo.
# Only when GLOWSKY_ENVIRONMENT is a dev value is that fallback key derived.
# NOTE: there is no rotation path — changing this key orphans every stored provider key.
GLOWSKY_SECRET_KEY=

# --- Nakitte platform auth (the only auth provider) ---
# Every request in every environment authenticates with a nakitte-carbon-auth access
# token: an RS256 JWT verified (RS256) against this JWKS endpoint. Identity
# (user/tenant/roles) comes from the token and the tenant is JIT-provisioned. There is
# no auth bypass — point this at a running carbon-auth (`:8081`) for local dev too.
GLOWSKY_NAKITTE_JWKS_URL=http://localhost:8081/.well-known/jwks.json
# Optional: enforce the `iss` claim (leave blank to skip the issuer check).
GLOWSKY_NAKITTE_JWT_ISSUER=
GLOWSKY_NAKITTE_JWT_AUDIENCE=carbon-platform

# --- Docking receptor confinement ---
# The `dock` tool only accepts receptor files resolving under this directory (path-traversal
# / arbitrary-read guard). Matches the ./examples/docking mount in the docking image.
GLOWSKY_DOCKING_RECEPTORS_DIR=examples/docking

# --- Slow-path queue & streaming ---
# Blank => Celery runs EAGER (in-process, no broker) with an in-memory job store.
# Set to a Redis URL to dispatch heavy tools to real workers + share job state
# across processes (start a worker with `make worker`).
#   GLOWSKY_REDIS_URL=redis://localhost:6379/0
GLOWSKY_REDIS_URL=

# --- Container tools (bring-your-own model, sandboxed `docker run`) ---
# OFF by default. BOTH of these are required before a `glowsky-tool.yaml` manifest is
# registered — setting only the directory leaves the registry at the 22 built-ins.
# The host needs a reachable Docker daemon; in Compose that means the opt-in
# docker-compose.tools.yml overlay, which mounts the (root-equivalent) Docker socket.
GLOWSKY_ENABLE_CONTAINER_TOOLS=false
#   GLOWSKY_TOOLS_DIR=examples/tools
GLOWSKY_TOOLS_DIR=

# --- BYO-LLM provider keys ---
# Leave ALL blank to run fully offline with the built-in "mock" provider.
# Set any of these to route the corresponding task class to a real provider.
GLOWSKY_ANTHROPIC_API_KEY=
GLOWSKY_OPENAI_API_KEY=
GLOWSKY_GROQ_API_KEY=
# Local / OpenAI-compatible endpoint (Ollama, vLLM):
GLOWSKY_LOCAL_BASE_URL=
GLOWSKY_LOCAL_API_KEY=

# --- Chemistry backends (adapter-gated; default "none" never fabricates values) ---
# ADMET: "rdkit" enables an offline estimator (ESOL solubility + QSPR/heuristics,
#        every value carries method + confidence + applicability domain).
GLOWSKY_ADMET_BACKEND=none        # none|rdkit
# Docking: "vina" wraps an AutoDock Vina binary (needs `vina` + `obabel` on PATH).
GLOWSKY_DOCKING_BACKEND=none      # none|vina
GLOWSKY_VINA_BIN=vina
GLOWSKY_OBABEL_BIN=obabel

# --- Model routing (provider/model per task class). "mock/mock" = offline. ---
# Examples:
#   GLOWSKY_ROUTE_REASONING=anthropic/claude-opus-4-8
#   GLOWSKY_ROUTE_FAST_TRIAGE=groq/llama-3.3-70b-versatile
GLOWSKY_ROUTE_REASONING=mock/mock
GLOWSKY_ROUTE_FAST_TRIAGE=mock/mock
GLOWSKY_ROUTE_CODEGEN=mock/mock
