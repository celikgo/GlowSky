# Python
__pycache__/
*.py[cod]
.venv/
.venv313/
*.egg-info/
.pytest_cache/

# Env & secrets — NEVER commit
.env
*.key

# docs/VALIDATION.md and docs/validation-results.json ARE committed — they are the
# published measurement record, and a partial local run merges into the record rather
# than replacing it (see tests/validation/_harness.py). Only the JUnit report, which is
# per-run scaffolding, is ignored.
validation-junit.xml

# Coverage artifacts (CI uploads coverage.xml as a run artifact instead)
.coverage
coverage.xml
htmlcov/

