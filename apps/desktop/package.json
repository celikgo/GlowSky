{
  "name": "glowsky-desktop",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Glowsky desktop app — the AI-native workspace for small-molecule drug design.",
  "scripts": {
    "postinstall": "node scripts/copy-rdkit.mjs",
    "predev": "node scripts/copy-rdkit.mjs",
    "prebuild": "node scripts/copy-rdkit.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "desktop:build": "tauri build"
  },
  "dependencies": {
    "3dmol": "^2.5.5",
    "@rdkit/rdkit": "2025.3.4-1.0.0",
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-opener": "^2.2.2",
    "ketcher-core": "3.15.0",
    "ketcher-react": "3.15.0",
    "ketcher-standalone": "3.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.1.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.3",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vitest": "^3.2.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
