{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Glowsky",
  "version": "0.0.1",
  "identifier": "com.glowsky.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Glowsky",
        "width": 1280,
        "height": 820,
        "minWidth": 940,
        "minHeight": 600,
        "theme": "Dark",
        "backgroundColor": "#15202B"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
